    "@angular/platform-browser": "^21.2.0",
    "papaparse": "^5.5.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.16",
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
