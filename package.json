{
  "name": "proof-label-review",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "dev": "ng serve --host 127.0.0.1",
